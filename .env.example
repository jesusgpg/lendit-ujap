# LendIt UJAP â€” variables de entorno de desarrollo
#
# Copia este archivo como .env y reemplaza los placeholders.
# Nunca subas .env ni pegues sus valores secretos en el repositorio.

NODE_ENV="development"
APP_URL="http://localhost:5173"


# Variables pÃºblicas usadas por Vue en el navegador.
# Se exponen intencionalmente; no son contraseÃ±as ni claves secretas.
VITE_SUPABASE_URL="https://PROJECT_REF.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# DÃ©jalo vacÃ­o si frontend y API usan el mismo dominio.
# VITE_API_BASE_URL=""

# Prisma en Supabase para el runtime de la API/serverless.
# El pooler de transacciones usa el puerto 6543 y pgbouncer=true.
# Copia la cadena desde Supabase > Connect y reemplaza solo el password.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"

# ConexiÃ³n directa para Prisma CLI, introspecciÃ³n y migraciones.
# Esta conexiÃ³n usa el host db.<PROJECT_REF>.supabase.co y el usuario postgres.
DIRECT_URL="postgresql://postgres:YOUR_DB_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# Alternativa para trabajar con PostgreSQL instalado localmente.
# La migraciÃ³n de Storage se omite en esta opciÃ³n; las fotos de objetos requieren Supabase.
# Si eliges esta opciÃ³n, reemplaza las dos variables anteriores:
# DATABASE_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/lendit_ujap?schema=public"
# DIRECT_URL="postgresql://postgres:YOUR_LOCAL_PASSWORD@localhost:5432/lendit_ujap?schema=public"

# Supabase Auth/API usadas por el frontend y las funciones serverless.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"

# Solo para backend/serverless. Nunca usar como variable VITE_* ni enviarla al navegador.
# SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_KEY"

# Solo backend: bÃºsqueda y selecciÃ³n de fotografÃ­as de categorÃ­as.
UNSPLASH_ACCESS_KEY="YOUR_UNSPLASH_ACCESS_KEY"

# Solo backend: cuenta central de LendIt para Pago Móvil. No uses variables VITE_*.
# Configura estos datos localmente y en Vercel antes de habilitar Pago Móvil.
LENDIT_MOBILE_HOLDER=""
LENDIT_MOBILE_BANK=""
LENDIT_MOBILE_PHONE=""
LENDIT_MOBILE_NATIONAL_ID=""
