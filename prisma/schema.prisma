generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ItemStatus {
  AVAILABLE
  PAUSED
  LENT
  REJECTED
}

enum ItemMode {
  LOAN
  RENTAL
}

enum LoanRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum LoanStatus {
  ACTIVE
  RETURNED
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  SIMULATED_PAID
  FAILED
  REFUNDED
}

enum Currency {
  USD
  EUR
  VES
}

// Roles administrables: el admin puede crear roles nuevos y asignarles permisos
// sin tocar código (ver Permission / RolePermission).
model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique @db.VarChar(60)
  description String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  users       User[]
  permissions RolePermission[]
  itemAudience ItemVisibility[]

  @@index([name])
}

// Catálogo de acciones que el sistema sabe otorgar. Sembrado por prisma/seed.ts.
model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique @db.VarChar(80)
  description String?
  createdAt   DateTime         @default(now())
  roles       RolePermission[]
}

model RolePermission {
  roleId       String     @db.Uuid
  permissionId String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model School {
  id      String   @id @default(uuid()) @db.Uuid
  name    String   @unique @db.VarChar(120)
  careers Career[]
}

model Career {
  id       String  @id @default(uuid()) @db.Uuid
  name     String  @unique @db.VarChar(120)
  schoolId String? @db.Uuid
  school   School? @relation(fields: [schoolId], references: [id], onDelete: SetNull)
  users    User[]

  @@index([schoolId])
}

model Category {
  id    String  @id @default(uuid()) @db.Uuid
  key   String  @unique @db.VarChar(60)
  label String  @db.VarChar(80)
  icon  String? @db.VarChar(8)
  blurb String?
  items Item[]
}

// Las credenciales y la verificación del correo viven en Supabase Auth.
// Esta tabla contiene el perfil y el dominio de negocio de LendIt.
model User {
  id                     String             @id @default(uuid()) @db.Uuid
  authUserId             String?            @unique @db.Uuid
  email                  String             @unique @db.VarChar(254)
  firstName              String             @db.VarChar(80)
  lastName               String             @db.VarChar(80)
  roleId                 String             @db.Uuid
  careerId               String             @db.Uuid
  isActive               Boolean            @default(true)
  phone                  String             @db.VarChar(30)
  photoUrl               String?
  emailVerifiedAt        DateTime?
  reliabilityScore       Decimal            @default(0) @db.Decimal(5, 2)
  reliabilityReviewCount Int                @default(0)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  role                   Role               @relation(fields: [roleId], references: [id], onDelete: Restrict)
  career                 Career             @relation(fields: [careerId], references: [id], onDelete: Restrict)
  items                  Item[]             @relation("ItemOwner")
  loanRequests           LoanRequest[]      @relation("LoanRequester")
  borrowedLoans          Loan[]             @relation("LoanBorrower")
  ownedLoans             Loan[]             @relation("LoanOwner")
  reviewsWritten         Review[]           @relation("ReviewAuthor")
  reviewsReceived        Review[]           @relation("ReviewTarget")
  payments               Payment[]
  qrChallenges           QrLoginChallenge[]

  @@index([roleId])
  @@index([emailVerifiedAt])
}

model Item {
  id              String            @id @default(uuid()) @db.Uuid
  code            String            @unique @db.VarChar(40)
  ownerId         String            @db.Uuid
  title           String            @db.VarChar(160)
  description     String?
  categoryId      String            @db.Uuid
  duration        String?           @db.VarChar(80)
  photoUrl        String?
  mode            ItemMode          @default(LOAN)
  price           Decimal?          @db.Decimal(12, 2)
  currency        Currency?
  status          ItemStatus        @default(AVAILABLE)
  rejectionReason String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  owner           User              @relation("ItemOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  category        Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  loanRequests    LoanRequest[]
  loans           Loan[]
  // Vacío = visible/alquilable por cualquier rol. Con filas = restringido a esos roles
  // (ej. "solo para profesores").
  visibleToRoles  ItemVisibility[]

  @@index([ownerId, status])
  @@index([categoryId, status])
}

model ItemVisibility {
  itemId String @db.Uuid
  roleId String @db.Uuid
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([itemId, roleId])
}

model LoanRequest {
  id          String            @id @default(uuid()) @db.Uuid
  itemId      String            @db.Uuid
  requesterId String            @db.Uuid
  startsAt    DateTime
  endsAt      DateTime
  message     String?
  status      LoanRequestStatus @default(PENDING)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  item        Item              @relation(fields: [itemId], references: [id], onDelete: Restrict)
  requester   User              @relation("LoanRequester", fields: [requesterId], references: [id], onDelete: Restrict)
  loan        Loan?
  payment     Payment?

  @@index([itemId, status])
  @@index([requesterId, status])
  @@index([startsAt, endsAt])
}

model Loan {
  id         String       @id @default(uuid()) @db.Uuid
  itemId     String       @db.Uuid
  ownerId    String       @db.Uuid
  borrowerId String       @db.Uuid
  requestId  String?      @unique @db.Uuid
  startsAt   DateTime
  endsAt     DateTime
  status     LoanStatus   @default(ACTIVE)
  returnedAt DateTime?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  item       Item         @relation(fields: [itemId], references: [id], onDelete: Restrict)
  owner      User         @relation("LoanOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  borrower   User         @relation("LoanBorrower", fields: [borrowerId], references: [id], onDelete: Restrict)
  request    LoanRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  reviews    Review[]
  payments   Payment[]

  @@index([itemId, status, startsAt, endsAt])
  @@index([borrowerId, status])
  @@index([ownerId, status])
}

// Solo se puede calificar tras un préstamo (Loan) ya finalizado — no hay calificación libre.
model Review {
  id        String   @id @default(uuid()) @db.Uuid
  loanId    String   @db.Uuid
  authorId  String   @db.Uuid
  targetId  String   @db.Uuid
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
  author    User     @relation("ReviewAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  target    User     @relation("ReviewTarget", fields: [targetId], references: [id], onDelete: Restrict)

  @@unique([loanId, authorId])
  @@index([targetId, createdAt])
}

model Payment {
  id                String        @id @default(uuid()) @db.Uuid
  userId            String        @db.Uuid
  loanId            String?       @db.Uuid
  requestId         String?       @unique @db.Uuid
  amount            Decimal       @db.Decimal(12, 2)
  currency          Currency
  status            PaymentStatus @default(PENDING)
  provider          String?       @db.VarChar(40)
  providerReference String?       @db.VarChar(120)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  user              User          @relation(fields: [userId], references: [id], onDelete: Restrict)
  loan              Loan?         @relation(fields: [loanId], references: [id], onDelete: SetNull)
  request           LoanRequest?  @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([loanId])
}

// Solo se persiste el hash del token. El QR debe ser de un solo uso y expirar.
model QrLoginChallenge {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @db.VarChar(128)
  userId     String?   @db.Uuid
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId, consumedAt])
}
