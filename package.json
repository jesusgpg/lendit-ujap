{
  "name": "lendit-ujap",
  "version": "1.0.0",
  "description": "Como Airbnb, pero para prestar cosas entre estudiantes por tiempo limitado.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "tsx watch server/dev-api.ts",
    "dev:full": "concurrently -n web,api -c blue,green \"pnpm dev\" \"pnpm dev:api\"",
    "build": "vue-tsc -b && tsc -p tsconfig.api.json && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:promote": "tsx scripts/promote-user.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.19.0",
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@supabase/supabase-js": "^2.116.0",
    "@vueuse/core": "^14.4.0",
    "dotenv": "^17.4.2",
    "emoji-picker-element": "^1.29.1",
    "express": "^5.2.1",
    "notivue": "^2.4.5",
    "pg": "^8.23.0",
    "pinia": "^2.3.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.40",
    "vue-router": "^4.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "concurrently": "^10.0.5",
    "prisma": "7.10.0",
    "typescript": "~6.0.2",
    "vercel": "^59.17.0",
    "vite": "^8.2.0",
    "vitest": "^2.1.8",
    "vue-tsc": "^3.3.8"
  }
}
